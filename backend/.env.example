# CallMateAI Stage 3 - MongoDB Atlas Cloud Integration Configuration
APP_NAME="CallMateAI Backend Engine"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="info"

# MongoDB Atlas Connection URI Template
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
MONGO_URI="mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority&appName=CallMateAI"

# MongoDB Database Name
DB_NAME="callmate_db"
