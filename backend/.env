# CallMateAI Stage 3 - MongoDB Configuration
APP_NAME="CallMateAI Backend Engine"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="info"

# MongoDB Connection URI (Local daemon or MongoDB Atlas Cloud)
# To use MongoDB Atlas Cloud, paste your mongodb+srv:// connection string here.
MONGO_URI="mongodb://127.0.0.1:27017/"
DB_NAME="callmate_db"
